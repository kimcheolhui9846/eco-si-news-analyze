PORT=3000
NODE_ENV=development

# 인증
MY_SECRET_PASSWORD=replace_with_login_password
SESSION_TTL_MINUTES=15

# OpenAI
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
LLM_MODE=live

# 입력 한도
MAX_REQUEST_BODY_BYTES=200000
MAX_NEWS_ITEMS=20
MAX_TITLE_CHARS=300
MAX_CONTENT_CHARS=8000
MAX_TREND_CHARS=1000
MAX_PROMPT_CHARS=120000
MAX_INPUT_TOKENS=30000

# rate limit
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10
ANALYZE_RATE_WINDOW_MS=900000
ANALYZE_RATE_MAX=30
SESSION_RATE_WINDOW_MS=900000
SESSION_RATE_MAX=20
MAX_CONCURRENT_ANALYSES=3

# 캐시
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=100

# circuit breaker
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MS=60000

# 비용 예산 — rate limit과 달리 총량을 막는다
# 사용량은 BUDGET_FILE에 기록되어 서버를 재시작해도 유지된다.
BUDGET_FILE=.budget.json
DAILY_ANALYSIS_LIMIT=50
MONTHLY_COST_LIMIT_USD=5
# 모델 단가($/100만 토큰). 실제 가격은 OpenAI 요금표에서 확인하고 맞춰 넣을 것.
PRICE_INPUT_PER_1M=2.5
PRICE_OUTPUT_PER_1M=10
# 출력 토큰 수는 호출 전에 알 수 없어 견적에서 이 값으로 가정한다.
ASSUMED_OUTPUT_TOKENS=2000
# 견적으로 받은 확인 토큰의 유효 시간
CONFIRM_TOKEN_TTL_MS=300000

# 외부 호출
EXTERNAL_TIMEOUT_MS=10000
MAX_EXTERNAL_RESPONSE_BYTES=2000000
EXTERNAL_ALLOWLIST=news.google.com,feeds.finance.yahoo.com,query1.finance.yahoo.com,api.coingecko.com,www.yna.co.kr,rss.etnews.com

# provider 회로 차단기
PROVIDER_BREAKER_THRESHOLD=3
PROVIDER_BREAKER_COOLDOWN_MS=60000

# 수집 캐시
NEWS_CACHE_TTL_MS=300000
MARKET_CACHE_TTL_MS=60000
SYMBOL_CACHE_TTL_MS=86400000

# CORS / 프록시
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
